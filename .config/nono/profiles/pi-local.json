{
  "extends": [
    "nolabs-ai/pi"
  ],
  "meta": {
    "name": "pi-local",
    "version": "1.0.0",
    "description": "Runtime-discovered path additions for pi",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": "allow_same_sandbox",
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "/dev/shm",
      "/run/user/1000/libpod",
      "/run/user/1000/podman",
      "~/.config/ai-shared",
      "~/.config/jj",
      "~/.config/mcp",
      "~/.local/share/containers",
      "~/.local/share/kotlin",
      "~/.local/state/pi-bg",
      "~/.m2",
      "~/Downloads",
      "~/dev",
      "~/nix-config",
      "~/.config/op"
    ],
    "read": [
      "/etc",
      "/etc/subguid",
      "/etc/subuid",
      "/tmp",
      "~/.config/gh",
      "~/.m2",
      "~/.ssh/known_hosts",
      "~/.jj"
    ],
    "write": [
      "~/.config/nono",
      "~/.npm",
      "~/.personal",
      "~/dev"
    ],
    "allow_file": [
      "~/.claude/certs/sipgate-ca-root_2018-06-01.crt",
      "/run/user/1000/op-daemon.pid"
    ],
    "read_file": [
      "~/.ssh/known_hosts",
      "~/.ssh/config"
    ],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [
      "~/.config/op",
      "~/.ssh/known_hosts",
      "~/.ssh/config"
    ],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "environment": {
    "deny_vars": [],
    "case_insensitive_vars": false,
    "set_vars": {
      "DOCKER_HOST": "unix:///run/user/1000/podman/podman.sock",
      "CONTAINER_HOST": "unix:///run/user/1000/podman/podman.sock"
    }
  },
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
