// https://yalter.github.io/niri/Configuration:-Window-Rules

// Floating
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="zen$" title="^Picture-in-Picture$"

    match app-id="^libTAS$"
    match app-id="^logsnap-ui$"
    match app-id="^Lumafly$"
    match app-id="^dev-ambershadow-cogfly-Cogfly$"

    match app-id="float"
    match app-id="^org.freedesktop.impl.portal.desktop.kde$"

    match title="^uniscan$"
    match title="^Edit Info-Template$"
    match title="^Welcome to IntelliJ IDEA$"
    match title="^Welcome to JetBrains"

    open-floating true
}

window-rule {
    match app-id="^hollow_knight.x86_64$"
    match app-id="^Hollow Knight Silksong$"
    open-fullscreen false

    // open-floating true
    open-focused false
    open-on-output "HDMI-A-1"
    default-column-width { proportion 1.0; }
    default-window-height { proportion 1.0; }
}
window-rule {
    match app-id="^Hollow Knight Silksong$"
    open-focused false
}


window-rule {
    match app-id="^livesplit-one-druid$"
    match title="^LiveSplit One"
    open-floating true
    open-focused false
    open-on-output "HDMI-A-1"
}

// Hide from capture
window-rule {
    match app-id="Bitwarden"

    block-out-from "screen-capture"
}

// Default to full-width
window-rule {
    match app-id="^Spotify$"
    match app-id="^zen$"
    match app-id="^discord$"
    match app-id="^steam$"
    match app-id="^dev.zed.Zed$"

    default-column-width { proportion 1.0; }
}

// Default to full-screen
window-rule {
    match app-id="^Celeste$"
    match app-id="^Hollow Knight Silksong$"
    match app-id="^steam_app_"

    open-fullscreen true
}

window-rule {
    match app-id="^CelesteStudio.GTK$"
    default-column-width { fixed 200; }
}

window-rule {
    match app-id="^factorio$"
    disable-mod-mouse-actions true
}
