// https://yalter.github.io/niri/Configuration:-Outputs

output "HDMI-A-1" {
    // position x=-1920 y=0
    position x=0 y=0
    global-workspace-index-base 1
}

output "DP-1" {
    // position x=0 y=0
    position x=1920 y=0
    mode "1920x1080@143.981"
    global-workspace-index-base 3
}

// mac laptop
output "eDP-1" {
    position x=-1920 y=1080
}
