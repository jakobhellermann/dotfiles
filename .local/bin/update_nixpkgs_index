#!/bin/sh
set -euo pipefail

download_nixpkgs_cache_index () {
  filename="index-$(uname -m | sed 's/^arm64$/aarch64/')-$(uname | tr A-Z a-z)"
  mkdir -p ~/.cache/nix-index && cd ~/.cache/nix-index
  curl -fsSL "https://github.com/nix-community/nix-index-database/releases/latest/download/$filename" -o "$filename"
  ln -f $filename files
}

download_nixpkgs_cache_index
